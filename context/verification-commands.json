{
  "schemaVersion": "1.0",
  "commands": {
    "compile": {
      "kind": "compile",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-Command",
        "$ErrorActionPreference='Stop'; & mvn -B '-DskipTests' compile; exit $LASTEXITCODE"
      ],
      "timeoutSeconds": 1800
    },
    "compile-tests": {
      "kind": "compile",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-Command",
        "$ErrorActionPreference='Stop'; & mvn -B '-DskipTests' test-compile; exit $LASTEXITCODE"
      ],
      "timeoutSeconds": 1800
    },
    "workspace-syntax": {
      "kind": "compile",
      "batch": "workspace-syntax",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/check-workspace.ps1",
        "-Mode",
        "Syntax"
      ],
      "timeoutSeconds": 300
    },
    "workspace-contract": {
      "kind": "test",
      "batch": "workspace-contract",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/check-workspace.ps1",
        "-Mode",
        "Contract"
      ],
      "timeoutSeconds": 300
    },
    "sop-tests": {
      "kind": "test",
      "batch": "sop-tests",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-sop/scripts/run-all-tests.ps1"
      ],
      "timeoutSeconds": 3600
    },
    "java-unit-smoke": {
      "kind": "test",
      "batch": "java-unit-smoke",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/run-java-tests.ps1",
        "-Project",
        "core",
        "-Test",
        "TagManagerTest",
        "-ExpectedTestsFile",
        "./.ai-workspace/context/test-suites/java-unit-smoke.json"
      ],
      "timeoutSeconds": 1800
    },
    "java-tests": {
      "kind": "test",
      "batch": "java-tests",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/run-java-tests.ps1"
      ],
      "timeoutSeconds": 1800
    },
    "workspace-script-tests": {
      "kind": "test",
      "batch": "workspace-script-tests",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/tooling.tests.ps1"
      ],
      "timeoutSeconds": 300
    },
    "state-integrity": {
      "kind": "test",
      "batch": "state-integrity",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/run-java-tests.ps1",
        "-Project",
        "game",
        "-Test",
        "PlayerSaveSnapshotTest,PlayerSaveOrderingTest,PlayerSaveRiskTest,PaymentIdempotencyTest",
        "-ExpectedTestsFile",
        "./.ai-workspace/context/test-suites/state-integrity.json"
      ],
      "timeoutSeconds": 1800
    },
    "runtime-evidence-tests": {
      "kind": "test",
      "batch": "runtime-evidence-tests",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/runtime-evidence.tests.ps1"
      ],
      "timeoutSeconds": 300
    },
    "runtime-identity-java": {
      "batch": "runtime-identity-java",
      "kind": "test",
      "executable": "pwsh",
      "timeoutSeconds": 1800,
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/run-java-tests.ps1",
        "-Test",
        "RuntimeIdentityInventoryTest,ScenarioRuntimeEvidenceTest,FrozenApolloTest",
        "-ExpectedTestsFile",
        "./.ai-workspace/context/test-suites/runtime-identity.json"
      ]
    },
    "runtime-concurrency-tests": {
      "executable": "pwsh",
      "timeoutSeconds": 180,
      "batch": "runtime-concurrency-tests",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/runtime-concurrency.tests.ps1"
      ],
      "kind": "test"
    },
    "payment-trial-tools": {
      "kind": "test",
      "batch": "payment-trial-tools",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/payment-sensitivity.tests.ps1"
      ],
      "timeoutSeconds": 300
    },
    "first-charge-calibration": {
      "kind": "test",
      "batch": "first-charge-calibration",
      "executable": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "./.ai-workspace/scripts/run-java-tests.ps1",
        "-Project",
        "game",
        "-Test",
        "FirstChargeCalibrationTest",
        "-ExpectedTestsFile",
        "./.ai-workspace/context/test-suites/first-charge-calibration.json"
      ],
      "timeoutSeconds": 1800
    }
  }
}
